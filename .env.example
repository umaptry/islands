# scripts/benchmark_embeddings.py 用の開発者向けキー。
#
# このファイルをコピーして .env を作り、値を入れてください。
#     cp .env.example .env
# .env は .gitignore 済みで、コミットも Docker イメージへのコピーもされません。
# 実際に読むのはベンチマークだけで、app.py も serving image も参照しません。
#
# 環境変数が既にあればそちらが優先されます（その場限りで上書きしたいとき用）。
# どちらも空なら、その提供元を飛ばしてローカル構成だけ測ります。

# https://aistudio.google.com/apikey で発行
GEMINI_API_KEY=

# 併せて比較したいときだけ。https://platform.openai.com/api-keys
OPENAI_API_KEY=
