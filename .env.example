# このファイルをコピーして .env を作り、値を入れてください。
#
#     cp .env.example .env
#
# .env は .gitignore 済みで、コミットも Docker イメージへのコピーもされません。
# 環境変数が既にあればそちらが優先されます。
#
# 何も設定しなくてもアプリは動きます（ローカルモード）。その場合:
#   - アカウントも投稿もメモリ上にのみ保存され、再起動で全て消えます
#   - ログインのパスコードはメールではなく画面に表示されます
#   - /api/local/* という Supabase の代役が有効になります（本番では404を返します）


# ---------------------------------------------------------------------------
# Supabase。URL・公開キー・サーバーキーを揃えると本番モードになります。
# Project Settings -> API Keys から取得します。
# ---------------------------------------------------------------------------

# 例: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# secret キー（sb_secret_...）を推奨。legacy service_role キーにも対応します。
# RLS を迂回できる強い権限です。
# サーバー側だけが保持し、ブラウザには一切渡しません。
SUPABASE_SERVICE_KEY=

# publishable キー（sb_publishable_...）を推奨。legacy anon キーにも対応します。
# 公開前提の値で、ブラウザに配ります（/api/config が返します）。
# 守っているのは鍵ではなく supabase/schema.sql の RLS ポリシーです。
SUPABASE_ANON_KEY=

# JWT の検証用。Project Settings -> API -> JWT Settings の JWT Secret。
# 新しい Supabase プロジェクトで非対称鍵（ES256）を使っている場合は不要で、
# core/auth.py がプロジェクトの JWKS を自動で引きます。
SUPABASE_JWT_SECRET=


# ---------------------------------------------------------------------------
# ソーシャルログイン。Supabase 側でプロバイダを有効にしてから 1 にしてください。
# 未設定ならログイン画面にボタンを出しません（押しても何も起きないボタンは
# 出さない、というのが islands から直した点のひとつです）。
# ---------------------------------------------------------------------------
KOTOBA_OAUTH_GOOGLE=
# Apple は有料の Apple Developer Program が必要です。
KOTOBA_OAUTH_APPLE=


# ---------------------------------------------------------------------------
# 投稿のレート制限。アカウント単位です（IP単位ではありません）。
# ---------------------------------------------------------------------------
KOTOBA_RATE_LIMIT_MAX=10
KOTOBA_RATE_LIMIT_WINDOW=300
# ローカル開発とテストで制限を切るとき。本番では設定しないでください。
KOTOBA_DISABLE_RATE_LIMIT=


# ---------------------------------------------------------------------------
# scripts/benchmark_embeddings.py 用の開発者向けキー。
# 実際に読むのはベンチマークだけで、app.py も serving image も参照しません。
# 追加パッケージは requirements-build.txt 側です。
# ---------------------------------------------------------------------------

# https://aistudio.google.com/apikey で発行
GEMINI_API_KEY=

# 併せて比較したいときだけ。https://platform.openai.com/api-keys
OPENAI_API_KEY=
